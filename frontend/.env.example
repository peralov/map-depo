VITE_APP_NAME=Open Waste Map
VITE_APP_TAGLINE=Map waste. Verify reports. Organize action.
VITE_API_URL=http://localhost:3000/api

# Create a public access token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.replace-with-your-public-token
VITE_MAP_STYLE=mapbox://styles/mapbox/satellite-streets-v12

# Longitude,latitude. The default below shows a world view.
VITE_MAP_CENTER=0,20
VITE_MAP_ZOOM=1.6

# Automatically frame all loaded sites. Set false to keep the configured viewport.
VITE_MAP_AUTO_FIT=true
